# Copy this file to .env and fill in real values, OR set these as
# environment variables through your hosting control panel (preferred on
# shared hosting — see README.md). Never commit a real .env file.

# Optional: enables real LLM-generated recommendations/chat/portfolio
# analysis via Gemini instead of the built-in rule-based engine.
GEMINI_API_KEY=

# Optional: used as a fallback (or instead of Gemini) for the same
# LLM-generated recommendations/chat/portfolio analysis, via OpenAI.
OPENAI_API_KEY=

# Optional: mirrors the Python backend's USE_TEST_ADS / MOBILE_API_URL
# settings exposed by GET /api/settings.
USE_TEST_ADS=true
MOBILE_API_URL=
